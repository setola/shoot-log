# Copy to .env (Compose interpolation, ignored). Replace these placeholders with
# `id -u` / `id -g`, or export LOCAL_UID/LOCAL_GID from your shell instead.
LOCAL_UID=
LOCAL_GID=
APP_PORT=5173
PREVIEW_PORT=4173
HTTPS_PORT=8443

# Comma-separated trusted DNS names, no scheme/port. IP literals and localhost
# are accepted by Vite by default. Keep host validation enabled.
DEV_ALLOWED_HOSTS=pi-workstation.villa.emanueletessore.com
DEV_TLS_HOST=localhost
TLS_UPSTREAM=web:5173

# PUBLIC browser configuration, explicitly passed to web/npm/preview.
# Use an OAuth Web application client with authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
VITE_GIT_COMMIT_SHA=

# CLI-only: passed to `publish`, never as VITE_* or image build arguments.
# Restrict the token to the intended Cloudflare account / Pages deployment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
